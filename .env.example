# ==============================================================================
# TANVEER STAFF MONITOR — ENVIRONMENT CONFIGURATION EXAMPLE
# Creator: MADE BY TANVEER | Discord: tanveer5637
# Copy this file to ".env" (or run `npm run setup`) and fill in your values.
# NEVER commit ".env" to version control.
# ==============================================================================

# --- Discord Bot Authentication (REQUIRED) ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Optional: Set a development guild ID for instant guild-scoped slash command testing.
# Leave blank in production to register global slash commands across all servers.
DISCORD_DEV_GUILD_ID=

# --- Permanent Global Owner Identity (IMMUTABLE) ---
# Locked in source code to "1131248987173814336". Any mismatch here is rejected/ignored.
GLOBAL_OWNER_ID=1131248987173814336

# --- Persistent Database & Storage ---
# Must point to persistent disk storage (NEVER /tmp).
DATABASE_PATH=./data/tanveer-monitor.sqlite
DATABASE_BACKUP_DIR=./data/backups
REPORT_EXPORT_DIR=./data/exports

# --- Gateway Intents Configuration ---
# GuildMembers intent is recommended for complete staff roster synchronization.
ENABLE_GUILD_MEMBERS_INTENT=true
# Presence intent is OPTIONAL and disabled by default (online status != staff work).
ENABLE_PRESENCE_INTENT=false
# MessageContent intent is OPTIONAL and disabled by default. Enable ONLY if you want
# deeper message length/token classification in ticket channels beyond message metadata/embeds.
ENABLE_MESSAGE_CONTENT_INTENT=false

# --- Scheduler & Monitoring Defaults ---
DEFAULT_SCAN_INTERVAL_MINUTES=360
SCHEDULER_TICK_SECONDS=60
AUTO_REGISTER_COMMANDS_ON_STARTUP=true

# --- Website Dashboard ---
# Set WEB_ENABLED=false to run the Discord bot without the HTTP dashboard.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Public origin used for cookies, CSRF origin checks and OAuth redirects.
# Use https:// in production. Behind Caddy/Nginx, keep this as the public URL.
WEB_BASE_URL=http://localhost:3000

# Discord Developer Portal -> OAuth2 -> Client Secret.
# REQUIRED for dashboard sign-in. Never commit this value.
DISCORD_CLIENT_SECRET=

# Must exactly match a redirect URL added in the Discord Developer Portal.
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback

# auto = Secure cookies when WEB_BASE_URL is https. true/false force it.
COOKIE_SECURE=auto
# Set true only when a trusted reverse proxy terminates TLS and forwards client IPs.
WEB_TRUST_PROXY=false

# --- Logging & Environment ---
NODE_ENV=production
LOG_LEVEL=info
